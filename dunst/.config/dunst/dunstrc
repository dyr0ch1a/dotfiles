[global]
    follow = mouse

    width = 320
    origin = top-right
    offset = 20x20

    notification_limit = 5

    separator_height = 2
    padding = 10
    horizontal_padding = 10
    frame_width = 2

    font = JetBrainsMono Nerd Font 10

    icon_position = left

    enable_recursive_icon_lookup = true

    markup = full
    format = "<b>%s</b>\n%b"

    sort = yes

    stack_duplicates = true
    always_run_script = true

    dmenu = /usr/bin/dmenu

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[urgency_low]
    background = "#0b0b0f"
    foreground = "#f2f2f2"
    frame_color = "#2a2a2f"
    timeout = 4

[urgency_normal]
    background = "#121016"
    foreground = "#f5f5f5"
    frame_color = "#5a2a4a"
    timeout = 6

[urgency_critical]
    background = "#1a0f14"
    foreground = "#ffffff"
    frame_color = "#ff4d8d"
    timeout = 0
